# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Configuration for Supabase Authentication and Database
# Set these in your environment / project settings
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_ACCESS_TOKEN: Personal Access Token from Supabase (Account -> Access Tokens)
# Used for Supabase Management API operations (never committed to repository)
SUPABASE_ACCESS_TOKEN=

# SUPABASE_SERVICE_ROLE_KEY: Privileged Supabase service_role secret (Supabase Dashboard -> Project Settings -> API)
# SERVER-ONLY. Used strictly by Node.js server.ts for Auth Admin user provisioning, management, and invitations.
# NEVER commit the actual secret. NEVER prefix with VITE_ or expose to client code.
SUPABASE_SERVICE_ROLE_KEY=

# RAZORPAY: Server-side payment processing secrets (India / Global checkout)
# RAZORPAY_KEY_ID: Razorpay Key ID (rzp_test_... or rzp_live_...) for online checkout
RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET: Razorpay Key Secret for server-side order creation and signature verification
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET: Secret for verifying incoming Razorpay webhook signatures
RAZORPAY_WEBHOOK_SECRET=

# DEPLOYMENT_WEBHOOK_URL: Optional webhook to trigger actual Cloudflare/Vercel/Cloud Run edge builds
DEPLOYMENT_WEBHOOK_URL=

