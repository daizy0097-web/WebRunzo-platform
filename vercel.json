{
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/env.js",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|env\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
